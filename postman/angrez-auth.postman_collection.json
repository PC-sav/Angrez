{
  "info": {
    "name": "Angrez — Auth (Step 3)",
    "_postman_id": "angrez-auth-step3",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Happy-path and failure-path runs for all four auth endpoints.\nSet the `baseUrl` collection variable to your Railway URL or http://localhost:3000."
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "token",   "value": "", "type": "string" },
    { "key": "devOtp",  "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "OTP Request",
      "item": [
        {
          "name": "✅ Happy path — valid Indian phone",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 ok', () => pm.response.to.have.status(200));",
                  "pm.test('ok:true', () => pm.expect(pm.response.json().ok).to.be.true);",
                  "const b = pm.response.json();",
                  "if (b.devOtp) pm.collectionVariables.set('devOtp', b.devOtp);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/otp/request",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"phone\": \"+919876543210\"}" }
          }
        },
        {
          "name": "❌ Bad phone — too short",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('400', () => pm.response.to.have.status(400));",
                  "pm.test('INVALID_PHONE', () => pm.expect(pm.response.json().error.code).to.eql('INVALID_PHONE'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/otp/request",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"phone\": \"12345\"}" }
          }
        },
        {
          "name": "❌ Missing phone field",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('400', () => pm.response.to.have.status(400));",
                  "pm.test('VALIDATION_ERROR', () => pm.expect(pm.response.json().error.code).to.eql('VALIDATION_ERROR'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/otp/request",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" }
          }
        }
      ]
    },
    {
      "name": "OTP Verify",
      "item": [
        {
          "name": "✅ Happy path — correct code (uses devOtp from request)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('has token', () => pm.expect(b.token).to.be.a('string'));",
                  "pm.collectionVariables.set('token', b.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/otp/verify",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"phone\": \"+919876543210\", \"code\": \"{{devOtp}}\"}" }
          }
        },
        {
          "name": "❌ Wrong code",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('401', () => pm.response.to.have.status(401));",
                  "pm.test('OTP_INVALID', () => pm.expect(pm.response.json().error.code).to.eql('OTP_INVALID'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/otp/verify",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"phone\": \"+919876543210\", \"code\": \"000000\"}" }
          }
        },
        {
          "name": "❌ Code not 6 digits",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('400', () => pm.response.to.have.status(400));",
                  "pm.test('VALIDATION_ERROR', () => pm.expect(pm.response.json().error.code).to.eql('VALIDATION_ERROR'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/otp/verify",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"phone\": \"+919876543210\", \"code\": \"123\"}" }
          }
        }
      ]
    },
    {
      "name": "Google Sign-In",
      "item": [
        {
          "name": "✅ Happy path — valid idToken (replace with real token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('has token', () => pm.expect(pm.response.json().token).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/google",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"idToken\": \"REPLACE_WITH_REAL_GOOGLE_ID_TOKEN\"}" }
          }
        },
        {
          "name": "❌ Invalid idToken",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('401', () => pm.response.to.have.status(401));",
                  "pm.test('GOOGLE_AUTH_FAILED', () => pm.expect(pm.response.json().error.code).to.eql('GOOGLE_AUTH_FAILED'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/google",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"idToken\": \"not.a.real.token\"}" }
          }
        },
        {
          "name": "❌ Missing idToken",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/google",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" }
          }
        }
      ]
    },
    {
      "name": "Auth Me",
      "item": [
        {
          "name": "✅ Happy path — valid Bearer token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('user present', () => pm.expect(pm.response.json().user).to.be.an('object'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/me",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "❌ No token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('401', () => pm.response.to.have.status(401));",
                  "pm.test('UNAUTHORIZED', () => pm.expect(pm.response.json().error.code).to.eql('UNAUTHORIZED'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/me"
          }
        },
        {
          "name": "❌ Invalid token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('401', () => pm.response.to.have.status(401));",
                  "pm.test('INVALID_TOKEN', () => pm.expect(pm.response.json().error.code).to.eql('INVALID_TOKEN'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/me",
            "header": [{ "key": "Authorization", "value": "Bearer garbage.token.value" }]
          }
        }
      ]
    }
  ]
}
