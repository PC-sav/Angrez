{
  "_meta": {
    "schema_version": "0.2",
    "model": "conversational-exchange",
    "note_for_team": "Angrez Stage 1, rebuilt around EXCHANGES, not isolated words. The unit is: someone says a prompt, the learner can speak ANY of several natural responses. Goal = arm the learner with ready-made natural Indian-English so she never freezes. Speech is primary on every practice puzzle; 'fallback' is the no-mic path only. All l1 strings are natural Devanagari, warm and encouraging (Mitthu's voice), never shaming. accept[] lists are intentionally forgiving (accent + ASR variants) — many right answers, never one.",
    "design_rules": {
      "responses_per_prompt": 3,
      "difficulty": "conversational chunks (was 'single words' in PRD v4.0 — conscious change, see chat)",
      "open_ended_prompts": "Where the answer depends on the learner (e.g. their own name), set open_ended:true and accept the FRAME ('my name is ___', 'i'm ___'); do not hard-check the name on-device.",
      "name_matching": "Use device speech result loosely; never fail a learner for an unrecognised proper noun."
    },
    "audio_convention": {
      "english": "audio/en/<key>.mp3 — English phrase, AI-TTS, native Indian-English + RP",
      "hindi": "audio/hi/<key>.mp3 — Hindi prompts, AI-TTS",
      "regenerable": true
    },
    "image_convention": "img/s1/<name>.webp — simple, clear, compressed.",
    "images_needed_stage1": [
      "img/s1/two_people_meeting.webp", "img/s1/handshake.webp", "img/s1/cup_of_tea.webp",
      "img/s1/waving_bye.webp", "img/s1/numbers_1_10.webp",
      "img/s1/colour_red.webp", "img/s1/colour_blue.webp", "img/s1/colour_green.webp",
      "img/s1/colour_yellow.webp", "img/s1/colour_black.webp", "img/s1/colour_white.webp"
    ]
  },

