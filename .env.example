# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# ── Test fence ───────────────────────────────────────────────────────────────
# REQUIRED to run `npm test` — tests read ONLY this var, never DATABASE_URL.
# Unset, or pointing at the prod project (by project ref, not host — Supabase's
# pooler host is shared regional infra), and the whole suite refuses to run
# before opening any DB connection. See tests/support/fence.ts.
# Pooler shape: postgresql://postgres.<test-project-ref>:<password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres
TEST_DATABASE_URL=

# ── Google Sign-In ────────────────────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── OTP ──────────────────────────────────────────────────────────────────────
OTP_STUB_MODE=true          # set false in production to send real OTPs
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# Test-only: permanent test numbers + future Play Store reviewer. Comma-separated
# E.164 numbers get TEST_PHONE_OTP as their fixed code instead of a real/random one,
# and no SMS provider is invoked for them. Leave either blank to disable entirely.
TEST_PHONE_ALLOWLIST=
TEST_PHONE_OTP=

# ── Exotel (placeholder — fill when ready) ───────────────────────────────────
EXOTEL_API_KEY=
EXOTEL_API_SECRET=
EXOTEL_SID=
EXOTEL_FROM=

# ── Firebase (placeholder — fill when ready) ─────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Cashfree Payments ────────────────────────────────────────────────────────
# All four are required.  In Railway: set these as Variables (not secrets).
# Sandbox creds for local dev / staging; swap to prod at launch.
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_ENV=sandbox

# ── Google Play Billing (D1c) ─────────────────────────────────────────────────
# Required in production; optional in dev/test (fails fast only when NODE_ENV=production).
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON is the full service-account JSON as a single-line
# string (not a file path). In Railway: set as Variables.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_PACKAGE_NAME=com.angrez.app
GOOGLE_PLAY_PUBSUB_AUDIENCE=

# ── Anthropic (placeholder — fill when ready) ────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
