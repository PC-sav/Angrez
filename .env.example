# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# ── Google Sign-In ────────────────────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── OTP ──────────────────────────────────────────────────────────────────────
OTP_STUB_MODE=true          # set false in production to send real OTPs
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# ── Exotel (placeholder — fill when ready) ───────────────────────────────────
EXOTEL_API_KEY=
EXOTEL_API_SECRET=
EXOTEL_SID=
EXOTEL_FROM=

# ── Firebase (placeholder — fill when ready) ─────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Cashfree Payments ────────────────────────────────────────────────────────
# All four are required.  In Railway: set these as Variables (not secrets).
# Sandbox creds for local dev / staging; swap to prod at launch.
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_ENV=sandbox

# ── Anthropic (placeholder — fill when ready) ────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
